LLM_API_KEY=
LLM_WORKSPACE_ID=
LLM_MODEL=claude-opus-5-5
# modelo por etapa: Haiku extrai proposições e pares, Sonnet classifica (NLI); vazio = LLM_MODEL
LLM_MODEL_MA=claude-haiku-5-5
